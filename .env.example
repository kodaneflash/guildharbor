# Required for database-backed authentication and mutations
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (required for verification delivery)
RESEND_API_KEY=
AUTH_EMAIL_FROM=Outlaw <accounts@example.com>

# Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (requires a public HTTPS callback)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled maintenance endpoint
MAINTENANCE_SECRET=

# Cloudflare Turnstile (required for production registration/social initiation)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only: public admits eligible pending members; private requires explicit approval.
# Omission defaults to public. Redeploy after changing.
COMMUNITY_ACCESS_MODE=public

# Required for encrypted seller-owned protected text; retain securely across deploys/backups.
# 32 random bytes encoded as 64 hexadecimal characters. Never expose to the browser.
DELIVERY_ENCRYPTION_KEY=

# Isolated malware scanner HTTPS endpoint; never mark files clean when unavailable.
FILE_SCANNER_URL=
FILE_SCANNER_TOKEN=

# NOWPayments Direct Payments: server-only; no public/browser key is used.
# Supplying credentials does NOT activate money movement.
NOWPAYMENTS_API_KEY=
# Set in NOWPayments notification settings, not the API key or public key.
NOWPAYMENTS_IPN_SECRET=
# Public HTTPS URL ending /api/payments/nowpayments/ipn
NOWPAYMENTS_IPN_CALLBACK_URL=
# USDT/Ethereum provider identifier; capability/settlement acceptance is still required.
NOWPAYMENTS_SETTLEMENT_TICKER=usdterc20
# Locally generated 32 random bytes as 64 hex characters; not supplied by NOWPayments.
FINANCIAL_EVIDENCE_ENCRYPTION_KEY=
FINANCIAL_EVIDENCE_KEY_VERSION=v1
# Telegram account linking and private notifications. Set all three in the website;
# set TELEGRAM_BRIDGE_SECRET and WEBSITE_URL in the bot to matching values.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BRIDGE_SECRET=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Exactly two account-approved pay-in assets, USDT/Ethereum (ERC-20) first and one
# verified conversion pair. Leave empty until merchant evidence is reviewed.
# JSON array fields: ticker, asset, network, decimals, tokenContract (null for
# native coins), memoRequired, verificationReference (restricted evidence ID).
# A marketing coin listing is not merchant, conversion or net-settlement approval.
NOWPAYMENTS_APPROVED_ASSETS=
# Short-lived merchant JWT for read-only payment-list recovery, when supplied by
# an operator. No password login or token renewal occurs in the application.
# Missing/expired JWT requires the existing operator payment-ID recovery command.
NOWPAYMENTS_READ_JWT=
